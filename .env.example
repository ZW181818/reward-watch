POSTGRES_DB=reward_watch
POSTGRES_USER=reward_watch
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql+psycopg://reward_watch:replace-with-a-long-random-password@localhost:5432/reward_watch
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
SYNC_MINUTE=20
SYNC_RUN_ON_STARTUP=true
APP_ENV=development
ADMIN_JWT_SECRET=replace-with-at-least-32-random-characters
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=reward-watch-media
R2_PUBLIC_BASE_URL=https://media.example.com
